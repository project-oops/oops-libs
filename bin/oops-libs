#!/usr/bin/env bash
# oops-libs - the dev CLI for the shared crates.
#
#   ./bin/oops-libs build          # release build
#   ./bin/oops-libs test           # the test suite
#   ./bin/oops-libs lint           # clippy at -D warnings
#   ./bin/oops-libs fmt            # format in place
#   ./bin/oops-libs check          # everything CI checks, in CI's order
#   ./bin/oops-libs clean          # remove build output
#   ./bin/oops-libs doc            # build the API docs
#
# Every verb covers the whole workspace with every feature on, because the file and OTLP
# log destinations and the platform directory lookup are features no default build compiles.
set -euo pipefail

cd "$(dirname "$0")/.."

FEATURES="--workspace --all-features"

build() { cargo build $FEATURES --release; }
test_() { cargo test $FEATURES; }
lint() { cargo clippy $FEATURES --all-targets -- -D warnings; }
fmt() { cargo fmt --all; }
clean() { cargo clean; }
doc() { cargo doc $FEATURES --no-deps; }

check() {
    cargo fmt --all -- --check
    lint
    test_
}

usage() {
    sed -n '2,13p' "$0" | sed 's|^# \{0,1\}||'
    exit "${1:-0}"
}

cmd="${1:-check}"
shift || true
case "$cmd" in
    check) check ;;
    build) build ;;
    test) test_ ;;
    lint) lint ;;
    fmt) fmt ;;
    clean) clean ;;
    doc) doc ;;
    -h | --help | help) usage ;;
    *)
        echo "unknown verb: $cmd" >&2
        usage 1
        ;;
esac
